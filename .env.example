# PDFNest Backend Environment Configuration
# Copy this file to .env for local development

# Server Configuration
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PDFNEST_WORKER_URL=http://localhost:8000

# Database & Cache (Required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pdfnest?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Admin Seed Account
ADMIN_EMAIL=admin@pdfnest.com
ADMIN_PASSWORD=admin123

# Authentication & Security (Secrets)
JWT_SECRET=<set-in-deployment>
FILE_ENCRYPTION_KEY=<set-32-byte-hex-secret-in-deployment>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Email / Mailer
RESEND_API_KEY=<resend-api-key>
FROM_EMAIL=PDFNest <onboarding@resend.dev>
SUPPORT_EMAIL=support@pdfnest.com

# Cloudflare R2 Object Storage (Secrets)
R2_BUCKET=pdfnest-storage
R2_ACCESS_KEY=<r2-access-key-id>
R2_SECRET_KEY=<r2-secret-access-key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Paddle Billing Integration
PADDLE_API_KEY=<paddle-api-key>
PADDLE_WEBHOOK_SECRET=<paddle-webhook-secret>
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com

# Paddle Price IDs (Credits & Subscriptions)
PADDLE_PRICE_CREDITS_10=pri_01kxggdm6690vza24j2ystbcsg
PADDLE_PRICE_CREDITS_20=pri_01kxggezdzj6gqm1ch15jb4kwr
PADDLE_PRICE_CREDITS_50=pri_01kxghz26vzhhb7ypvr95z39x3
PADDLE_PRICE_CREDITS_100=pri_01kxgj2dm1xa8jxy9qa3x0dxhd
PADDLE_PRICE_CREDITS_200=pri_01kxgj3kf45n3by33h01gnz6fm
PADDLE_PRICE_CREDITS_500=pri_01kxgj58xc72039j7ry6prt64n
PADDLE_PRICE_PLUS_MONTHLY=pri_01kxg33j9t57cf6kanxtyq5dhe
PADDLE_PRICE_PLUS_YEARLY=pri_01kxg34mskm92jwzqcf1sfngz0
PADDLE_PRICE_PRO_MONTHLY=pri_01kxg2sqywj6a76y09zkbkwt55
PADDLE_PRICE_PRO_YEARLY=pri_01kxg2yas97gcsgyfmz9a88s0p

# P1 Resource Protection & Concurrency Limits (Defaults below, configure to override)
MAX_CONCURRENT_HEAVY_JOBS=4
MAX_PAGES_OCR=150
MAX_PAGES_RASTERIZE=300
MAX_PAGES_COMPRESS=500
MAX_PAGES_GRAYSCALE=500
MAX_PAGES_OFFICE_CONVERT=200
MAX_PAGES_GENERAL=1000
